		summarizeBy: sum
		sourceColumn: DelinquencyRatePct

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column DigitalAdoptionPct
		dataType: double
		lineageTag: 70dece0d-7427-4957-8761-5e84783f83c6
		summarizeBy: sum
		sourceColumn: DigitalAdoptionPct

